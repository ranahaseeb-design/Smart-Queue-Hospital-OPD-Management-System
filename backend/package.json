{
  "name": "smart-opd-backend",
  "version": "1.0.0",
  "description": "Smart Digital Queue Management System for Hospital OPD - REST API + Socket.IO real-time channel",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/db/init.js",
    "seed": "node src/db/seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.8",
    "morgan": "^1.10.0",
    "nodemailer": "^10.3.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  }
}
