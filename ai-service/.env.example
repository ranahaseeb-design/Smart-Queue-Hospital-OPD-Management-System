# Copy to .env (loaded automatically) or set in the environment.

# Database: the backend's SQLite dev DB (path relative to the ai-service folder) ...
DATABASE_URL=sqlite:///../backend/data/smart_opd.db
# ... or the canonical MySQL 8 database (database/schema.mysql.sql):
# DATABASE_URL=mysql+pymysql://opd_user:change-me@localhost:3306/smart_opd

# Folder holding <version>.joblib model files (model_versions rows point here).
MODELS_DIR=./models

# Hospital local time zone; DB datetimes are naive local time.
HOSPITAL_TZ=Asia/Karachi

# CPU cores for Random Forests (-1 = all).
AI_N_JOBS=-1
# RandomizedSearchCV iterations during retraining (Section 6.4.2).
AI_SEARCH_ITER=8
# Retraining is refused below this many labelled tokens.
AI_MIN_TRAINING_ROWS=200
# History window (days) of the forecasting job.
AI_FORECAST_LOOKBACK_DAYS=182

LOG_LEVEL=INFO
