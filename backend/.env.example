# Copy to backend/.env (loaded automatically) or set the variables in the environment.

# ---- Server ----
PORT=4000
NODE_ENV=development
# Hospital local time zone; all datetimes are stored and served in this zone.
TZ=Asia/Karachi
# Comma-separated list of allowed browser origins (staff + admin dashboards). Use * to allow any.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# HTTP request logging (morgan); defaults to true outside NODE_ENV=test
LOG_REQUESTS=true

# ---- Auth ----
# REQUIRED in every environment. The server refuses to start when JWT_SECRET is missing,
# shorter than 32 characters or a placeholder (such as the value below). `npm run setup` creates
# backend/.env from this file and fills in a random secret; or generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---- Database (MongoDB) ----
# The database name is the URI path (smart_opd). Transactions need a replica set: a local
# single-node replica set (mongod.cfg "replication: replSetName: rs0" + rs.initiate()) or a
# MongoDB Atlas cluster (mongodb+srv://<user>:<password>@<cluster>/smart_opd?retryWrites=true&w=majority).
# The AI service uses the same MONGODB_URI.
MONGODB_URI=mongodb://127.0.0.1:27017/smart_opd?replicaSet=rs0
# How long to wait for the server when connecting (ms)
MONGODB_TIMEOUT_MS=10000
# Create the demo data automatically when the server starts against an empty database
AUTO_SEED=false
# Days of synthetic history generated by `npm run seed`
SEED_HISTORY_DAYS=60

# ---- AI service (FastAPI) ----
# Leave empty to disable the AI service entirely (baseline predictions, JS ranking/forecasts).
AI_SERVICE_URL=http://localhost:8000
# Shared secret sent as the X-AI-Service-Token header; must equal AI_SERVICE_TOKEN in
# ai-service/.env (the AI service rejects /ai/* calls without it). `npm run setup` fills in a random
# value; or generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AI_SERVICE_TOKEN=
# Timeout of prediction / ranking calls (contract: 1.5 s) and of long jobs (forecast, retrain)
AI_TIMEOUT_MS=1500
AI_JOB_TIMEOUT_MS=600000

# ---- Demo behaviour ----
# true = doctors accept patients regardless of clock time (a schedule for the weekday is still required)
DEMO_ALWAYS_OPEN=true
# Background jobs (hourly forecasts, nightly averages, end-of-day closure)
JOBS_ENABLED=true

# ---- Optional notification channels (in-app notifications are always on) ----
# Push via Firebase Cloud Messaging: path to (or inline JSON of) a service-account key.
# Requires `npm install firebase-admin` (not a default dependency).
FIREBASE_SERVICE_ACCOUNT=
# E-mail via SMTP (nodemailer). Leave SMTP_HOST empty to disable e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart OPD <no-reply@opd.test>"
