# Base URL of the backend (REST is served under /api, Socket.IO on the same origin).
VITE_API_URL=http://localhost:4000
# Optional: override the Socket.IO URL (defaults to VITE_API_URL).
# VITE_SOCKET_URL=http://localhost:4000
# Hospital time zone used for elapsed-time counters (must match the backend TZ).
# VITE_HOSPITAL_TZ=Asia/Karachi
