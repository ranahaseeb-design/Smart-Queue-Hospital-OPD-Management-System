# Base URL of the backend (REST is served under /api, Socket.IO on the same origin)
VITE_API_URL=http://localhost:4000

# Hospital time zone of the backend (TZ). API datetimes are hospital wall-clock times; the dashboard
# uses this zone for "today" and relative times even if the browser runs in another zone.
VITE_HOSPITAL_TZ=Asia/Karachi
